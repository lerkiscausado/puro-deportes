# Puerto en el que escucha el servidor HTTP de NestJS
PORT=3000

# ──────────────────────────────────────────────
# Base de datos (MySQL / TypeORM)
# ──────────────────────────────────────────────

# Host del servidor MySQL (usar "localhost" para desarrollo local)
DB_HOST=localhost

# Puerto del servidor MySQL (por defecto 3306)
DB_PORT=3306

# Nombre de usuario con acceso a la base de datos
DB_USERNAME=root

# Contraseña del usuario de la base de datos
DB_PASSWORD=tu_contraseña_segura

# Nombre de la base de datos del proyecto
DB_DATABASE=puro_deporte

# ──────────────────────────────────────────────
# Autenticación JWT
# ──────────────────────────────────────────────

# Clave secreta usada para firmar y verificar los tokens JWT (debe ser larga y aleatoria)
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_aleatorio

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────

# Origen(es) permitidos para peticiones cross-origin. Acepta uno o varios orígenes
# separados por comas. Ejemplo con varios: http://localhost:3001,https://purodeporte.com
CORS_ORIGIN=http://localhost:3001

# ──────────────────────────────────────────────
# Entorno de ejecución
# ──────────────────────────────────────────────

# Entorno actual de la aplicación: "development", "production" o "test"
NODE_ENV=development

# ──────────────────────────────────────────────
# Almacenamiento de archivos (uploads)
# ──────────────────────────────────────────────

# Ruta base donde se guardan los archivos subidos (logos, fotos de torneos y noticias).
# En desarrollo local se puede usar una ruta relativa; en producción (Docker) debe ser
# la ruta INTERNA del volumen montado en el contenedor (ej: /app/uploads), para que
# los archivos persistan entre redeployments y no se pierdan al reconstruir la imagen.
UPLOADS_PATH=./uploads

# ──────────────────────────────────────────────
# Servicio de Correo Electrónico (Resend)
# ──────────────────────────────────────────────

# Clave de API de Resend para envío de correos trasnaccionales (comienza con "re_")
RESEND_API_KEY=re_tu_api_key_aqui

# Nombre y dirección de correo del remitente verificado en Resend
EMAIL_FROM=Puro Deporte <noreply@purodeporte.co>

# URL base del cliente Frontend (usado para construir enlaces de verificación)
FRONTEND_URL=http://localhost:3001

